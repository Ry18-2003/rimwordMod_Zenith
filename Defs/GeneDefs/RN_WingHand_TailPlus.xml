<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!-- 2 -->
    <GeneDef>
        <defName>RN_HandsTailWings2</defName>
        <label>evo primate (extra wings)</label>
        <description>The bearer possesses elongated fingers, an agile tail, and a set of glidewings. These functions as extra limbs and stabilizers, significantly increasing manipulation and mobility.</description>
        
        <iconPath>Genes/RN_EVO</iconPath>
        <iconColor>(0.8, 0.8, 0.8)</iconColor>
        <displayCategory>ComboGenes</displayCategory>        
        <biostatCpx>2</biostatCpx>
        <biostatMet>-3</biostatMet>
        <capMods>
            <li>
                <capacity>Manipulation</capacity>
                <postFactor>1.1</postFactor>
            </li>
            <li>
                <capacity>Manipulation</capacity>
                <offset>0.05</offset>
            </li>
        </capMods>

        <statOffsets>
            <MoveSpeed>0.05</MoveSpeed>
            <CarryBulk MayRequire="CETeam.CombatExtended">25</CarryBulk>
        </statOffsets>

        <statFactors>
            <CarryWeight MayRequire="CETeam.CombatExtended">1.5</CarryWeight>
        </statFactors>

        <modExtensions>
            <li Class="VEF.Genes.GeneExtension">
                <hediffToWholeBody>RN_Glidewings</hediffToWholeBody>
            </li>
        </modExtensions>

        <customEffectDescriptions>
            <li>It is not slowed down by objects on the ground.</li>
        </customEffectDescriptions>
        
        <renderNodeProperties>
            <li>
                <workerClass>PawnRenderNodeWorker_AttachmentBody</workerClass>
                <texPath>Things/Pawn/Humanlike/BodyAttachments/SmoothTail/SmoothTail</texPath>
                <colorType>Hair</colorType>
                <overrideMeshSize>(1.3, 1.3)</overrideMeshSize>
                <parentTagDef>Body</parentTagDef>
                <drawData>
                    <scaleOffsetByBodySize>true</scaleOffsetByBodySize>
                    <defaultData>
                        <layer>-3</layer>
                    </defaultData>
                    <dataNorth>
                        <offset>(0, 0, -0.15)</offset>
                        <layer>221</layer>
                    </dataNorth>
                    <dataSouth>
                        <offset>(0, 0, -0.15)</offset>
                    </dataSouth>
                    <dataEast>
                        <offset>(-0.5, 0, -0.15)</offset>
                    </dataEast>
                    <dataWest>
                        <offset>(0.5, 0, -0.15)</offset>
                    </dataWest>
                </drawData>
            </li>
            <li>
                <workerClass>PawnRenderNodeWorker_AttachmentBody</workerClass>
                <texPaths>
                <li>Pawn/Gliderwings/RNWings</li>
                </texPaths>
                <colorType>Hair</colorType>
                <overrideMeshSize>(1.0, 1.0)</overrideMeshSize>
                <parentTagDef>Body</parentTagDef>
                <rotDrawMode>Fresh, Rotting</rotDrawMode>
                <drawSize>1.5</drawSize>
                <drawData>
                <scaleOffsetByBodySize>true</scaleOffsetByBodySize>
                <defaultData>
                    <layer>-2</layer>
                </defaultData>
                <dataNorth>
                    <offset>(0, 0.1, -0.05)</offset>
                    <layer>90</layer>
                </dataNorth>
                <dataSouth>
                    <offset>(0, 0, -0.05)</offset>
                </dataSouth>
                <dataEast>
                    <offset>(-0.08, 0, -0.04)</offset>
                    <layer>90</layer>
                </dataEast>
                <dataWest>
                    <offset>(0.08, 0, -0.04)</offset>
                    <layer>90</layer>
                </dataWest>
                </drawData>
            </li>
        </renderNodeProperties>

        <exclusionTags>
            <li>Tail</li>
            <li>Hands</li>
            <li>Wings</li> 
        </exclusionTags>

        <abilities>
            <li>LeapTailWings2</li>
        </abilities>
    </GeneDef>

